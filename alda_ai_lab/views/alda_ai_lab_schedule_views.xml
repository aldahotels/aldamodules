<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="alda_ai_lab_schedule_view_tree" model="ir.ui.view">
        <field name="model">alda.ai.lab.schedule</field>
        <field name="arch" type="xml">
            <tree
                decoration-muted="state != 'active'"
                decoration-danger="last_state == 'error'"
            >
                <field name="name" />
                <field name="user_id" />
                <field name="recipient_ids" widget="many2many_tags" />
                <field name="next_run" />
                <field name="last_run" />
                <field name="last_state" />
                <field name="run_count" />
                <field name="state" />
            </tree>
        </field>
    </record>
    <record id="alda_ai_lab_schedule_view_form" model="ir.ui.view">
        <field name="model">alda.ai.lab.schedule</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <h1><field name="name" /></h1>
                    <group>
                        <group>
                            <field name="tool_id" />
                            <field name="period" />
                            <field name="frequency" />
                            <field
                                name="weekday"
                                attrs="{'invisible': [('frequency', '!=', 'weekly')]}"
                            />
                            <field
                                name="day_of_month"
                                attrs="{'invisible': [('frequency', '!=', 'monthly')]}"
                            />
                            <field name="time_of_day" widget="float_time" />
                            <field name="tz" />
                        </group>
                        <group>
                            <field name="user_id" />
                            <field name="recipient_ids" widget="many2many_tags" />
                            <field name="property_ids" widget="many2many_tags" />
                            <field name="salesperson_ids" widget="many2many_tags" />
                            <field name="next_run" />
                            <field name="last_run" />
                            <field name="last_state" />
                            <field name="last_error" />
                            <field name="run_count" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="alda_ai_lab_schedule_action" model="ir.actions.act_window">
        <field name="name">Scheduled reports (AI lab)</field>
        <field name="res_model">alda.ai.lab.schedule</field>
        <field name="view_mode">tree,form</field>
    </record>
    <menuitem
        id="alda_ai_lab_schedule_menu"
        name="Scheduled reports (lab)"
        parent="ai_tool.ai_menu_root"
        action="alda_ai_lab_schedule_action"
        sequence="50"
    />
</odoo>
