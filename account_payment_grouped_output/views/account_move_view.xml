<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_move_form_grouped_output" model="ir.ui.view">
        <field name="name">account.move.form.grouped.output</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='id']" position="after">
                <field name="reconciled_statement_line_id" invisible="1" />
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="button_open_reconciled_statement_line"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-bank"
                    string="Show Transaction"
                    attrs="{'invisible': [('reconciled_statement_line_id', '=', False)]}"
                />
            </xpath>
        </field>
    </record>
</odoo>
