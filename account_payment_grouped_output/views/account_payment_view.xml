<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_account_payment_form_grouped_output" model="ir.ui.view">
        <field name="name">account.payment.form.grouped.output</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form" />
        <field name="arch" type="xml">
            <field name="paired_internal_transfer_payment_id" position="after">
                <field name="grouped_payments_move_id" invisible="1" />
            </field>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="button_open_grouped_payments_move"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-object-group"
                    attrs="{'invisible': [('grouped_payments_move_id', '=', False)]}"
                >
                    <div class="o_stat_info">
                        <span class="o_stat_text">Grouped Move</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
