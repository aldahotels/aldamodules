<odoo>
    <!-- Formulario de creación de ticket -->
    <template id="create_ticket_form" name="Formulario de Ticket">
        <t t-call="website.layout">
            <div class="container mt-5 mb-5">
                <h2>Crear nuevo ticket</h2>
                <form action="/helpdesk/ticket/submit" method="POST" class="mt-4">
                    <!-- <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/> -->

                    <!-- Campos ocultos -->
                    <input type="hidden" name="partner_id" t-att-value="partner_id" />
                    <input type="hidden" name="team_id" t-att-value="team_id" />
                    <input
                        type="text"
                        name="portal_user_id"
                        t-att-value="portal_user_id"
                    />

                    <div class="mb-3">
                        <label class="form-label">Usuario ID</label>

                        <input
                            type="text"
                            name="user_name"
                            class="form-control"
                            t-att-value="user_name or ''"
                            readonly="readonly"
                        />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Nombre del contacto</label>
                        <input
                            type="text"
                            name="partner_name"
                            class="form-control"
                            t-att-value="partner_name or ''"
                            readonly="readonly"
                        />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">ID de Propiedad</label>
                        <input
                            type="hidden"
                            name="property_id"
                            class="form-control"
                            t-att-value="property_id or ''"
                            readonly="readonly"
                        />
                    </div>

                    <!-- <div class="mb-3">
                        <label class="form-label">Equipo / Departamento</label>
                        <input
                            type="hidden"
                            name="team"
                            class="form-control"
                            t-att-value="team_id"
                            readonly="readonly"
                        />
                    </div> -->

                    <div class="mb-3">
                        <label class="form-label">Clase</label>
                        <select
                            name="ticket_class_id"
                            class="form-control"
                            required="1"
                        >
                            <option value="">Selecciona una Clase</option>
                            <t t-foreach="ticket_class_ids" t-as="ticket_class">
                                <option t-att-value="ticket_class.id"><t
                                        t-out="ticket_class.name"
                                    /></option>
                            </t>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Asunto</label>
                        <input
                            type="text"
                            name="subject"
                            class="form-control"
                            required="1"
                        />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Descripción</label>
                        <textarea name="description" class="form-control" rows="4" />
                    </div>

                    <button type="submit" class="btn btn-primary">Enviar ticket</button>
                </form>
            </div>
        </t>
    </template>
