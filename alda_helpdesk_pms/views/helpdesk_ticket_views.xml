<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="helpdesk_ticket_type_view_form" model="ir.ui.view">
        <field name="name">helpdesk.ticket.type.form.inherit</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id" ref="helpdesk.helpdesk_ticket_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button
                    string="Update Blocked"
                    name="action_update_is_room_blocked"
                    type="object"
                    class="btn-secondary"
                />
            </xpath>
            <xpath
                expr="//div[@class='oe_title']/h1/field[@name='name']"
                position="after"
            >
                <div class="mt-2">
                    <field
                        name="tag_detail"
                        widget="many2many_tags"
                        options="{'color_field': 'color'}"
                    />
                </div>
                <field name="season_type" invisible="1" />
                <widget
                    name="web_ribbon"
                    title="High Season"
                    bg_color="text-bg-warning"
                    attrs="{'invisible': [('season_type', '!=', 'high')]}"
                />

            </xpath>
            <xpath expr="//field[@name='ticket_type_id']" position="attributes">
                <attribute
                    name="options"
                >{"no_create": true, "no_open": true}</attribute>
            </xpath>
            <xpath expr="//field[@name='email_cc']" position="after">
                <field name="company_external_id" />
            </xpath>
            <xpath expr="//field[@name='tag_ids']" position="attributes">
                <attribute name="options">{"no_create": true,
                    "no_open": true,
                    'color_field': 'color'}
                </attribute>
            </xpath>
        </field>
    </record>
    <record id="helpdesk_ticket_type_view_form_pms" model="ir.ui.view">
        <field name="name">helpdesk.ticket.type.form.inherit.pms</field>
        <field name="model">helpdesk.ticket</field>
        <field
            name="inherit_id"
            ref="alda_helpdesk_pms_enterprise.pms_helpdesk_ticket_view_form"
        />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='pms_property_id']" position="after">
                <field name="is_room_blocked" invisible="1" />
                <field name="is_room" invisible="1" />
                <field name="is_bathroom" invisible="1" />
                <field name="location_type" />
            </xpath>
            <xpath expr="//field[@name='pms_room_id']" position="attributes">
                <attribute name="attrs">
                    {'invisible': [('location_type', 'not in', ['room', 'bathroom'])]}
                </attribute>
            </xpath>
        </field>
    </record>

    <!-- Vista tree -->
    <record id="helpdesk_ticket_type_view_tree" model="ir.ui.view">
        <field name="name">helpdesk.ticket.type.tree.inherit</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id" ref="helpdesk.helpdesk_tickets_view_tree" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='ticket_type_id']" position="attributes">
                <attribute name="options">{'color_field': 'color'}
                </attribute>
            </xpath>
            <xpath expr="//field[@name='team_id']" position="before">
                <field name="location_type" optional="hide" />
                <field name="is_room" optional="hide" />
                <field name="is_room_blocked" optional="hide" />
                <field name="is_bathroom" optional="hide" />
                <field
                    name="tag_detail"
                    widget="many2many_tags"
                    options="{'color_field': 'color'}"
                />
                <field name="company_external_id" optional="hide" />
            </xpath>
        </field>
    </record>
    <!-- Vista kanban -->
    <record id="alda_pms_helpdesk_ticket_view_kanban" model="ir.ui.view">
        <field name="name">alda.helpdesk.ticket.kanban.inherit.pms</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id" ref="helpdesk.helpdesk_ticket_view_kanban" />
        <field name="arch" type="xml">
            <xpath expr="//kanban" position="attributes">
                <attribute name="on_write">1</attribute>
                <attribute name="color_field">color</attribute>
            </xpath>
            <xpath
                expr="//div[./field[@name='tag_ids' and @widget='many2many_tags']]"
                position="before"
            >
                    <div class="oe_kanban_card_content p-2">
                        <div class="mb-2">
                            <field
                            name="tag_detail"
                            widget="many2many_tags"
                            options="{'color_field': 'color'}"
                        />
                        </div>
                    </div>
            </xpath>
        </field>
    </record>

    <!-- Vista search -->
    <record id="pms_helpdesk_ticket_search_inherit" model="ir.ui.view">
        <field name="name">helpdesk.ticket.search.inherit.pms</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id" ref="helpdesk.helpdesk_tickets_view_search" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='team_id']" position="after">
                <field name="is_room_blocked" />
                <field name="is_room" />
                <field name="company_external_id" />
                <field name="location_type" />
            </xpath>
            <xpath expr="//group" position="inside">
                <filter
                    string="Blocked"
                    name="group_blocked"
                    context="{'group_by': 'is_room_blocked'}"
                />
                <filter
                    string="Room's ticket"
                    name="group_is_room"
                    context="{'group_by': 'is_room'}"
                />
                <filter
                    string="Bathroom's room"
                    name="group_is_bathroom"
                    context="{'group_by': 'is_bathroom'}"
                />
                <filter
                    string="Location type"
                    name="group_location_type"
                    context="{'group_by': 'location_type'}"
                />
                <filter
                    string="Repair External ID"
                    name="group_company_external"
                    context="{'group_by': 'company_external_id'}"
                />
            </xpath>
            <xpath expr="//filter[@name='my_follow_ticket']" position="before">
                <filter
                    string="Room Blocked"
                    name="filter_blocked"
                    domain="[('is_room_blocked','!=', False)]"
                />
                <filter
                    string="Room's ticket"
                    name="filter_is_room"
                    domain="[('is_room','!=', False)]"
                />
                <filter
                    string="Bathroom's room"
                    name="filter_is_bathroom"
                    domain="[('is_bathroom','!=', False)]"
                />
                <filter
                    string="Location type"
                    name="filter_location_type"
                    domain="[('location_type','!=', False)]"
                />
                <filter
                    string="Repair External ID"
                    name="filter_company_external"
                    domain="[('company_external_id','!=', False)]"
                />
            </xpath>
        </field>
    </record>
</odoo>
