<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="helpdesk_purchase_description">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <h4 class="card-title text-primary mb-3">
                    🛒 Purchase Request
                </h4>
                <p class="mb-2">
                    <strong>🏨 Property:</strong> <t t-esc="property_name" /><br />
                    <strong>📦 Number of Products:</strong> <t t-esc="num_products" />
                </p>
                <hr />
                <div class="table-responsive d-none d-md-block mt-3">
                    <table
                        class="table table-sm table-striped table-hover align-middle"
                    >
                        <thead class="table-light">
                            <tr>
                                <th>#</th>
                                <th>Product</th>
                                <th>Supplier</th>
                                <th>Purchase URL</th>
                                <th>Units</th>
                                <th>Measurements</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="products" t-as="p">
                                <tr>
                                    <td><t t-esc="p['index']" /></td>
                                    <td><t t-esc="p['name']" /></td>
                                    <td><t t-esc="p['supplier']" /></td>
                                    <td class="text-truncate" style="max-width:120px;">
                                        <t t-if="p['url']">
                                            <a t-att-href="p['url']" target="_blank">
                                                <t t-esc="p['url']" />
                                            </a>
                                        </t>
                                        <t t-if="not p['url']" />
                                    </td>
                                    <td><t t-esc="p['quantity']" /></td>
                                    <td>
                                        <t t-esc="p['measurements']" />
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
                <t t-foreach="products" t-as="p">
                    <div class="d-block d-md-none mb-2 p-2 border rounded shadow-sm">
                        <p><strong>Product #<t t-esc="p['index']" />:</strong></p>
                        <p><t t-esc="p['name']" /></p>
                        <p><strong>Supplier:</strong> <t t-esc="p['supplier']" /></p>
                        <p><strong>URL:</strong>
                            <t t-if="p['url']">
                                <span
                                    class="text-truncate d-block"
                                    style="max-width: 200px;"
                                >
                                    <a
                                        t-att-href="p['url']"
                                        target="_blank"
                                        class="text-truncate"
                                    >
                                        <t t-esc="p['url']" />
                                    </a>
                                </span>
                            </t>
                            <t t-if="not p['url']">—</t>
                        </p>
                        <p><strong>Units:</strong> <t t-esc="p['quantity']" /></p>
                        <p><strong>Measurements:</strong> <t
                                t-esc="p['measurements']"
                            /></p>
                    </div>
                </t>

                <t t-if="additional_description">
                    <div class="mt-3">
                        <h6 class="text-secondary fw-bold">📝 Additional Comments</h6>
                        <p><t t-raw="additional_description" /></p>
                    </div>
                </t>
            </div>
        </div>
    </template>
</odoo>
