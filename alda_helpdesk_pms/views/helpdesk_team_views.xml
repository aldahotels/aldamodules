<?xml version="1.0" ?>
<odoo>

    <!-- HELPDESK.TEAM -->
    <record id="helpdesk_team_pms_view_form" model="ir.ui.view">
        <field name="name">helpdesk.team.pms.form</field>
        <field name="model">helpdesk.team</field>
        <field name="inherit_id" ref="helpdesk.helpdesk_team_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@id='productivity']" position="after">
                <h2>Purchase</h2>
                <div class="row mt16 o_settings_container">
                    <div class="col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane">
                            <field name="is_purchases_form" />
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="is_purchases_form" />
                            <div class="text-muted">
                                Enable purchase ticket form for this team. When selected, users will see a specialized purchase form instead of the standard ticket form.
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
            <xpath expr="//div[@id='alias_channels']" position="inside">
                <div class="col-lg-6 o_setting_box">
                    <div class="o_setting_left_pane">
                        <field name="is_pms_form" widget="boolean" />
                    </div>
                    <div class="o_setting_right_pane">
                        <label
                            for="is_pms_form"
                            string="Show team in PMS-Romdoo form"
                        />
                    </div>
                </div>
                <div class="col-lg-6 o_setting_box">
                    <div class="o_setting_left_pane">
                        <field name="is_location_required" widget="boolean" />
                    </div>
                    <div class="o_setting_right_pane">
                        <label
                            for="is_location_required"
                            string="Location Required in form"
                        />
                    </div>
                </div>
            </xpath>
            <xpath expr="//div[@id='self-Service']" position="inside">
                <div class="col-lg-6 o_setting_box">
                    <div class="o_setting_left_pane">
                        <field name="allow_portal_ticket_closing_technician" />
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="allow_portal_ticket_closing_technician" />
                        <div class="text-muted">
                            Allow your technician to close their own tickets
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
