<odoo>
    <!-- Home con botón -->
    <template
        id="portal_my_home_helpdesk"
        name="Home con tickets"
        inherit_id="portal.portal_my_home"
    >
        <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="title">Tickets</t>
                <t t-set="url" t-value="'/my/tickets'" />
                <t t-set="placeholder_count" t-value="'ticket_count'" />
            </t>
        </xpath>
        <xpath expr="//div[hasclass('o_portal_docs')]" position="after">
            <a class="btn btn-primary mt-4" href="/my/new_ticket">Crear nuevo ticket</a>
        </xpath>
    </template>
</odoo>
