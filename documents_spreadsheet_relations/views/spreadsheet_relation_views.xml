<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!--Vista form para el asistente -->
    <record id="view_spreadsheet_relation_wizard_form" model="ir.ui.view">
        <field name="name">spreadsheet.relation.wizard.form</field>
        <field name="model">spreadsheet.relation.wizard</field>
        <field name="arch" type="xml">
            <form string="Configurar relación de hoja de cálculo">
                <sheet>
                    <group>
                        <field
                            name="document_id"
                            options="{'no_create': True, 'no_open': True}"
                        />
                        <field
                            name="document_name"
                            placeholder="Buscar por nombre del documento"
                        />
                        <field
                            name="relation_key"
                            placeholder="Valor para relacionar con otras hojas"
                        />
                        <field name="extract_from_cell" />
                        <field
                            name="cell_coordinate"
                            attrs="{'invisible': [('extract_from_cell', '=', False)], 'required': [('extract_from_cell', '=', True)]}"
                            placeholder="Ej: A1, B2, etc."
                        />
                    </group>
                    <div
                        class="alert alert-info"
                        role="alert"
                        attrs="{'invisible': [('extract_from_cell', '=', False)]}"
                    >
                        Nota: Puede extraer valores de celdas de archivos XLS y XLSX.
                    </div>

                </sheet>
                <footer>
                    <button
                        name="action_extract_and_save"
                        string="Guardar"
                        type="object"
                        class="btn-primary"
                    />
                    <button string="Cancelar" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
