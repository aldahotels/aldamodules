<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="views_pms_property_form_inherit_tickets" model="ir.ui.view">
        <field name="name">pms.property.form.inherit.tickets.alda</field>
        <field name="model">pms.property</field>
        <field name="inherit_id" ref="pms.pms_property_views_form" />
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="after">
                    <div class="oe_button_box" name="button_box_tickets">
                        <button
                        name="action_view_tickets"
                        type="object"
                        icon="fa-ticket"
                        class="oe_stat_button"
                    >
                            <field
                            string="Tickets"
                            name="ticket_count"
                            widget="statinfo"
                        />
                        </button>
                    </div>
            </xpath>
        </field>
    </record>
</odoo>
