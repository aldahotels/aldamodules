<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="helpdesk_ticket_user_pms_property" model="ir.rule">
        <field name="name">PMS - Helpdesk Ticket User</field>
        <field name="model_id" ref="model_helpdesk_ticket" />
        <field name="domain_force">
            ['|',
                ('pms_property_id','=',False),('pms_property_id', 'in',
                user.pms_property_ids.ids)
            ]
        </field>
        <field name="groups" eval="[(4, ref('helpdesk.group_helpdesk_user'))]" />
    </record>
    <record id="helpdesk_ticket_company_property_rule" model="ir.rule">
        <field name="name">Tickets: multi-company + allowed properties</field>
        <field name="model_id" ref="model_helpdesk_ticket" />
        <field name="domain_force">
            [
                ('company_id', 'in', company_ids + [False]),
                    ('pms_property_id', 'in', user.pms_property_ids.ids + [False])
            ]
        </field>
    </record>
    <record
        id="helpdesk_ticket_report_analysis_property_rule_multi_company"
        model="ir.rule"
    >
        <field name="name">Helpdesk Ticket Report PMS: multi-company</field>
        <field name="model_id" ref="model_helpdesk_ticket" />
        <field name="domain_force">
            [
                ('company_id', 'in', company_ids + [False]),
                    ('pms_property_id', 'in', user.pms_property_ids.ids + [False])
            ]</field>
    </record>
</odoo>
