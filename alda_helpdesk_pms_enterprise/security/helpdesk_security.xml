<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="helpdesk_ticket_company_property_rule" model="ir.rule">
        <field name="name">Tickets: multi-company + allowed properties</field>
        <field name="model_id" ref="model_helpdesk_ticket" />
        <field name="domain_force">
            [
                ('company_id', 'in', company_ids + [False]),
                    ('pms_property_id', 'in', user.pms_property_ids.ids + [False])
            ]
        </field>
    </record>
    <record
        id="helpdesk_ticket_report_analysis_property_rule_multi_company"
        model="ir.rule"
    >
        <field name="name">Helpdesk Ticket Report PMS: multi-company</field>
        <field name="model_id" ref="helpdesk.model_helpdesk_ticket_report_analysis" />
        <field name="domain_force">
            [
                ('company_id', 'in', company_ids + [False]),
                    ('ticket_id.pms_property_id', 'in', user.pms_property_ids.ids + [False])
            ]</field>
    </record>
    <record id="helpdesk_sla_report_analysis_property_rule" model="ir.rule">
        <field name="name">Helpdesk SLA Report PMS: allowed properties</field>
        <field name="model_id" ref="helpdesk.model_helpdesk_sla_report_analysis" />
        <field name="domain_force">
            [('ticket_id.pms_property_id', 'in', user.pms_property_ids.ids + [False])]
        </field>
    </record>
</odoo>
