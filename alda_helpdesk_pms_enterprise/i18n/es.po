#. module: alda_helpdesk_pms_enterprise
#: model:mail.template,body_html:alda_helpdesk_pms_enterprise.alda_confirmation_ticket
msgid ""
"<div style=\"box-sizing:border-box; font-family:'Satoshi',sans-serif; background-color:#f9f9f9; margin:0; padding:0;\">\n"
"                    <table cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"box-sizing:border-box; border-collapse:collapse; max-width:100%; margin:0 auto; padding:20px;\">\n"
"                        <tbody>\n"
"                            <tr>\n"
"                                <td align=\"center\">\n"
"                                    <table cellpadding=\"0\" cellspacing=\"0\" width=\"560\" style=\"box-sizing:border-box; border-collapse:collapse; background-color:#ffffff; border-radius:8px; overflow:hidden; font-family:'Satoshi',sans-serif;\">\n"
"                                        <tbody>\n"
"                                            <tr>\n"
"                                                <td style=\"background-color:#1b1b1b; padding:20px; text-align:center; color:#fff;\">\n"
"                                                    <table width=\"100%\" style=\"box-sizing:border-box; border-collapse:collapse; text-align:center;\">\n"
"                                                        <tbody>\n"
"                                                            <tr>\n"
"                                                                <td align=\"left\" width=\"50%\">\n"
"                                                                    <img src=\"https://odoo.gestionalda.es/web/image/1985649-4ebfb289/Logo_Alda2025_blanco_sin_fondo.png\" alt=\"Alda Hotels\" style=\"max-width:120px; width:100%; height:auto; object-fit:cover;\">\n"
"                                                                </td>\n"
"                                                                <td align=\"right\" width=\"50%\">\n"
"                                                                    <a href=\"https://www.facebook.com/AldaHotels/\" style=\"text-decoration:none; color:#008f8c; margin:0 4px;\">\n"
"                                                                        <img src=\"https://firma.aldahotels.es/img/fb_white.png\" width=\"24\" height=\"24\" style=\"vertical-align:middle;\">\n"
"                                                                    </a>\n"
"                                                                    <a href=\"https://www.youtube.com/channel/UCJ20x2dNJt5JIOgONS59aDw\" style=\"text-decoration:none; color:#008f8c; margin:0 4px;\">\n"
"                                                                        <img src=\"https://firma.aldahotels.es/img/yt_white.png\" width=\"24\" height=\"24\" style=\"vertical-align:middle;\">\n"
"                                                                    </a>\n"
"                                                                    <a href=\"https://www.instagram.com/aldahotels/?hl=en\" style=\"text-decoration:none; color:#008f8c; margin:0 4px;\">\n"
"                                                                        <img src=\"https://firma.aldahotels.es/img/ig_white.png\" width=\"24\" height=\"24\" style=\"vertical-align:middle;\">\n"
"                                                                    </a>\n"
"                                                                    <a href=\"https://es.linkedin.com/company/aldahotels\" style=\"text-decoration:none; color:#008f8c; margin:0 4px;\">\n"
"                                                                        <img src=\"https://firma.aldahotels.es/img/in_white.png\" width=\"24\" height=\"25\" style=\"vertical-align:middle;\">\n"
"                                                                    </a>\n"
"                                                                    <a href=\"https://twitter.com/AldaHotels\" style=\"text-decoration:none; color:#008f8c; margin:0 4px;\">\n"
"                                                                        <img src=\"https://firma.aldahotels.es/img/x_white.png\" width=\"24\" height=\"24\" style=\"vertical-align:middle;\">\n"
"                                                                    </a>\n"
"                                                                    <div style=\"margin-top:8px;\">\n"
"                                                                        <a href=\"https://www.aldahotels.es/\" style=\"color:#ffffff; text-decoration:none; font-size:13px;\">aldahotels.es</a>\n"
"                                                                    </div>\n"
"                                                                </td>\n"
"                                                            </tr>\n"
"                                                        </tbody>\n"
"                                                    </table>\n"
"                                                </td>\n"
"                                            </tr>\n"
"                                            <tr>\n"
"                                                <td style=\"padding:40px 30px; color:#333333; font-size:16px; line-height:1.5;\">\n"
"                                                    Dear <t t-out=\"object.sudo().partner_id.name or 'Customer'\">Customer</t>,<br>\n"
"                                                    Your request \n"
"                                                    <t t-if=\"object.get_portal_url()\">\n"
"                                                        <a t-attf-href=\"/my/ticket/{{ object.id }}/{{ object.access_token }}\" style=\"color:#008f8c; text-decoration:none;\" t-out=\"object.name or ''\"></a>\n"
"                                                    </t>\n"
"                                                    has been received and is being reviewed by our team <t t-out=\"object.team_id.name or ''\">Helpdesk</t>.<br>\n"
"                                                    The reference of your ticket is <strong style=\"font-weight:bold;\">#<t t-out=\"object.ticket_ref or ''\">15</t></strong>.<br><br>\n"
"\n"
"                                                    <div style=\"text-align:center; margin:20px 0;\">\n"
"                                                        <a style=\"background-color:#875A7B; color:#fff; padding:10px 20px; text-decoration:none; border-radius:4px; display:inline-block;\" t-att-href=\"object.get_portal_url()\" target=\"_blank\">View the ticket</a>\n"
"                                                    </div>\n"
"\n"
"                                                    To add additional comments, reply to this email and we will get back to you soon.<br><br>\n"
"\n"
"                                                    <t t-if=\"object.team_id.show_knowledge_base\">\n"
"                                                        Please don’t hesitate to visit our \n"
"                                                        <a t-attf-href=\"{{ object.team_id.get_knowledge_base_url() }}\" style=\"color:#008f8c; text-decoration:none;\">Help Center</a>. \n"
"                                                        You might find the answer to your question.<br><br>\n"
"                                                    </t>\n"
"\n"
"                                                    Thank you,<br><br>\n"
"                                                    The <t t-out=\"object.team_id.name or 'Helpdesk'\">Helpdesk</t> Team.\n"
"                                                </td>\n"
"                                            </tr>\n"
"                                        </tbody>\n"
"                                    </table>\n"
"                                </td>\n"
"                            </tr>\n"
"                        </tbody>\n"
"                    </table>\n"
"                </div>\n"
"            "
