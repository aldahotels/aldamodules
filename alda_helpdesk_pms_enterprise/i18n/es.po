"                                                                    </div>\n"
"                                                                </td>\n"
"                                                            </tr>\n"
"                                                        </tbody>\n"
"                                                    </table>\n"
"                                                </td>\n"
"                                            </tr>\n"
"                                            <tr>\n"
"                                                <td style=\"padding:40px 30px; color:#333333; font-size:16px; line-height:1.5;\">\n"
"                                                    Estimado/a <t t-out=\"object.sudo().partner_id.name or 'Cliente'\">Cliente</t>,<br><br>\n"
"                                                    Hemos recibido su solicitud \n"
"                                                    <t t-if=\"object.get_portal_url()\">\n"
"                                                        <a t-attf-href=\"/my/ticket/{{ object.id }}/{{ object.access_token }}\" style=\"color:#008f8c; text-decoration:none;\" t-out=\"object.name or ''\"></a>\n"
"                                                    </t>\n"
"                                                    <t t-if=\"object.pms_property_id\">\n"
"                                                        Referida al Hotel: <br>\n"
"                                                        <center><t t-out=\"object.pms_property_id.partner_id.name or ''\"></t></center>\n"
"                                                    </t>\n"
"                                                    <t t-if=\"object.user_id\">\n"
"                                                        <br>Asignado a: <t t-out=\"object.user_id.name\"></t>\n"
"                                                    </t>\n"
"                                                    <br>\n"
"                                                    y está siendo revisada por nuestro equipo <t t-out=\"object.team_id.name or ''\">Helpdesk</t>.<br>\n"
"                                                    La referencia de su ticket es <strong style=\"font-weight:bold;\">#<t t-out=\"object.ticket_ref or ''\">15</t></strong>.<br><br>\n"
"\n"
"                                                    <div style=\"text-align:center; margin:20px 0;\">\n"
"                                                        <a style=\"background-color:#875A7B; color:#fff; padding:10px 20px; text-decoration:none; border-radius:4px; display:inline-block;\" t-att-href=\"object.get_portal_url()\" target=\"_blank\">Ver el ticket</a>\n"
"                                                    </div>\n"
"\n"
"                                                    Para agregar preguntas o comentarios adicionales, responda a este correo electrónico y nos pondremos en contacto con usted a la brevedad.<br><br>\n"
"\n"
"                                                    <t t-if=\"object.team_id.show_knowledge_base\">\n"
"                                                        Por favor, no dude en visitar nuestro \n"
"                                                        <a t-attf-href=\"{{ object.team_id.get_knowledge_base_url() }}\" style=\"color:#008f8c; text-decoration:none;\">centro de ayuda</a>. \n"
"                                                        Es posible que encuentre la respuesta a su pregunta.<br><br>\n"
"                                                    </t>\n"
"\n"
"                                                    Gracias,<br><br>\n"
"                                                    Equipo <t t-out=\"object.team_id.name or 'Helpdesk'\">Helpdesk</t>.\n"
