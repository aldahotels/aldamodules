<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="views_pms_property_form_inherit_tickets" model="ir.ui.view">
        <field name="name">pms.property.form.inherit.tickets.alda</field>
        <field name="model">pms.property</field>
        <field name="inherit_id" ref="pms.pms_property_views_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
            <button
                    class="oe_stat_button"
                    type="object"
                    name="action_view_tickets"
                    icon="fa-life-ring"
                >
                <div class="o_field_widget o_stat_info">
                    <span class="o_stat_value">
                        <field name="ticket_count" nolabel="1" />
                        <span class="text-secondary fw-normal"> Tickets</span>
                    </span>
                </div>
            </button>
            </xpath>
        </field>
    </record>
</odoo>
