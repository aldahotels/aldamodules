#. module: alda_ai_tool_helpdesk
#. odoo-python
#: code:addons/alda_ai_tool_helpdesk/models/alda_helpdesk_tools.py:0
#, python-format
msgid ""
"%(open)s open tickets: %(new)s under 2 days, %(mid)s from 2 to 7 days, "
"%(old)s over 7 days; %(unassigned)s without assignee."
msgstr ""
"%(open)s tickets abiertos: %(new)s de menos de 2 días, %(mid)s de 2 a 7 "
"días, %(old)s de más de 7 días; %(unassigned)s sin asignar."

#. module: alda_ai_tool_helpdesk
#. odoo-python
#: code:addons/alda_ai_tool_helpdesk/models/alda_helpdesk_tools.py:0
#, python-format
msgid "%(shown)s of the %(total)s tickets that match."
msgstr "%(shown)s de los %(total)s tickets que coinciden."

#. module: alda_ai_tool_helpdesk
#. odoo-python
#: code:addons/alda_ai_tool_helpdesk/models/alda_helpdesk_tools.py:0
#, python-format
msgid ""
"%(user)s already has an open activity %(summary)s on the ticket %(ref)s."
msgstr ""
"%(user)s ya tiene una actividad abierta %(summary)s en el ticket %(ref)s."

#. module: alda_ai_tool_helpdesk
#. odoo-python
#: code:addons/alda_ai_tool_helpdesk/models/alda_helpdesk_tools.py:0
#, python-format
msgid ""
"%(user)s cannot read the ticket %(ref)s, so the activity would not reach "
"them. Choose someone of the team."
msgstr ""
"%(user)s no puede leer el ticket %(ref)s, así que la actividad no le "
"llegaría. Elige a alguien del equipo."

#. module: alda_ai_tool_helpdesk
#. odoo-python
#: code:addons/alda_ai_tool_helpdesk/models/alda_helpdesk_tools.py:0
#, python-format
msgid ""
"%s will receive the assignment email of Odoo when the activity is created."
msgstr ""
"%s recibirá el correo de asignación de Odoo cuando se cree la actividad."

#. module: alda_ai_tool_helpdesk
#. odoo-python
#: code:addons/alda_ai_tool_helpdesk/models/alda_helpdesk_tools.py:0
#, python-format
msgid "Activity created on the ticket %(ref)s for %(user)s."
msgstr "Actividad creada en el ticket %(ref)s para %(user)s."

#. module: alda_ai_tool_helpdesk
#. odoo-python
#: code:addons/alda_ai_tool_helpdesk/models/alda_helpdesk_tools.py:0
msgid ""
"Age counts from the creation of the ticket: under 2 days, from 2 to 7 days "
"and over 7 days add up to the open tickets. unassigned counts the open "
"tickets without assignee, whatever their age."
msgstr ""
"La antigüedad cuenta desde la creación del ticket: menos de 2 días, de 2 a "
"7 días y más de 7 días suman los tickets abiertos. unassigned cuenta los "
"tickets abiertos sin asignado, sea cual sea su antigüedad."

#. module: alda_ai_tool_helpdesk
#. odoo-python
#: code:addons/alda_ai_tool_helpdesk/models/alda_helpdesk_tools.py:0
msgid "Give the number of the ticket (ticket_ref)."
msgstr "Indica el número del ticket (ticket_ref)."

#. module: alda_ai_tool_helpdesk
#. odoo-python
#: code:addons/alda_ai_tool_helpdesk/models/alda_helpdesk_tools.py:0
msgid "Internal note"
msgstr "Nota interna"

#. module: alda_ai_tool_helpdesk
#. odoo-python
#: code:addons/alda_ai_tool_helpdesk/models/alda_helpdesk_tools.py:0
#, python-format
msgid "Internal note posted on the ticket %s."
msgstr "Nota interna publicada en el ticket %s."

#. module: alda_ai_tool_helpdesk
#. odoo-python
#: code:addons/alda_ai_tool_helpdesk/models/alda_helpdesk_tools.py:0
#, python-format
msgid ""
"Messages: the last %(count)s comments and e-mails, oldest first, as plain "
"text cut to %(chars)s characters. Internal ones are notes that the "
"customer does not see."
msgstr ""
"Mensajes: los últimos %(count)s comentarios y correos, del más antiguo al "
"más reciente, en texto plano cortado a %(chars)s caracteres. Los internos "
"son notas que el cliente no ve."

#. module: alda_ai_tool_helpdesk
#. odoo-python
#: code:addons/alda_ai_tool_helpdesk/models/alda_helpdesk_tools.py:0
#, python-format
msgid "No ticket found with the number %s among those you can see."
msgstr ""
"No se ha encontrado ningún ticket con el número %s entre los que puedes "
"ver."

#. module: alda_ai_tool_helpdesk
#. odoo-python
#: code:addons/alda_ai_tool_helpdesk/models/alda_helpdesk_tools.py:0
#, python-format
msgid ""
"Only the first %(shown)s of %(total)s tickets are shown: narrow the search."
msgstr ""
"Solo se muestran los primeros %(shown)s de %(total)s tickets: acota la "
"búsqueda."

#. module: alda_ai_tool_helpdesk
#. odoo-python
#: code:addons/alda_ai_tool_helpdesk/models/alda_helpdesk_tools.py:0
msgid ""
"Open: tickets whose stage is not folded in the pipeline of their team. "
"Tickets without a hotel are included; the rest are limited to your hotels."
msgstr ""
"Abiertos: tickets cuya etapa no está plegada en el flujo de su equipo. Se "
"incluyen los tickets sin hotel; el resto se limita a tus hoteles."

#. module: alda_ai_tool_helpdesk
#. odoo-python
#: code:addons/alda_ai_tool_helpdesk/models/alda_helpdesk_tools.py:0
#, python-format
msgid "Post an internal note on the ticket %(ref)s: %(title)s."
msgstr "Publicar una nota interna en el ticket %(ref)s: %(title)s."

#. module: alda_ai_tool_helpdesk
#. odoo-python
#: code:addons/alda_ai_tool_helpdesk/models/alda_helpdesk_tools.py:0
#, python-format
msgid ""
"Schedule the activity %(summary)s on the ticket %(ref)s for %(user)s, due "
"on %(date)s."
msgstr ""
"Programar la actividad %(summary)s en el ticket %(ref)s para %(user)s, con "
"vencimiento el %(date)s."

#. module: alda_ai_tool_helpdesk
#. odoo-python
#: code:addons/alda_ai_tool_helpdesk/models/alda_helpdesk_tools.py:0
#, python-format
msgid "Several tickets have the number %(ref)s (teams: %(teams)s)."
msgstr "Varios tickets tienen el número %(ref)s (equipos: %(teams)s)."

#. module: alda_ai_tool_helpdesk
#. odoo-python
#: code:addons/alda_ai_tool_helpdesk/models/alda_helpdesk_tools.py:0
msgid ""
"The activity is a To-Do on the ticket. Odoo sends the assigned user its "
"usual assignment email and the user becomes a follower of the ticket."
msgstr ""
"La actividad es una tarea pendiente en el ticket. Odoo envía al usuario "
"asignado su correo habitual de asignación y el usuario pasa a seguir el "
"ticket."

#. module: alda_ai_tool_helpdesk
#. odoo-python
#: code:addons/alda_ai_tool_helpdesk/models/alda_helpdesk_tools.py:0
msgid ""
"The customer is the person who opened the ticket; the e-mail and the phone "
"are masked, and so are the e-mails and phone numbers found in the texts."
msgstr ""
"El cliente es quien abrió el ticket; el correo y el teléfono van "
"enmascarados, igual que los correos y teléfonos que aparecen en los textos."

#. module: alda_ai_tool_helpdesk
#. odoo-python
#: code:addons/alda_ai_tool_helpdesk/models/alda_helpdesk_tools.py:0
msgid "The deadline cannot be in the past."
msgstr "El vencimiento no puede estar en el pasado."

#. module: alda_ai_tool_helpdesk
#. odoo-python
#: code:addons/alda_ai_tool_helpdesk/models/alda_helpdesk_tools.py:0
#, python-format
msgid "The deadline cannot be more than %s days away."
msgstr "El vencimiento no puede estar a más de %s días."

#. module: alda_ai_tool_helpdesk
#. odoo-python
#: code:addons/alda_ai_tool_helpdesk/models/alda_helpdesk_tools.py:0
msgid ""
"The links stored on a ticket are the hotel and the room (Alda tickets have "
"no folio field)."
msgstr ""
"Los vínculos que guarda un ticket son el hotel y la habitación (los "
"tickets de Alda no tienen campo de folio)."

#. module: alda_ai_tool_helpdesk
#. odoo-python
#: code:addons/alda_ai_tool_helpdesk/models/alda_helpdesk_tools.py:0
msgid "The note is empty."
msgstr "La nota está vacía."

#. module: alda_ai_tool_helpdesk
#. odoo-python
#: code:addons/alda_ai_tool_helpdesk/models/alda_helpdesk_tools.py:0
msgid ""
"The note is internal: the customer does not see it and nobody is named in "
"it, so no e-mail goes to anyone in particular. It is posted in the name of "
"the user who confirms it."
msgstr ""
"La nota es interna: el cliente no la ve y no nombra a nadie, así que no se "
"envía ningún correo a nadie en concreto. Se publica a nombre del usuario "
"que la confirma."

#. module: alda_ai_tool_helpdesk
#. odoo-python
#: code:addons/alda_ai_tool_helpdesk/models/alda_helpdesk_tools.py:0
msgid ""
"The number users see is ticket_ref, not the internal id. A ticket is open "
"while its stage is not folded in the pipeline of its team."
msgstr ""
"El número que ven los usuarios es ticket_ref, no el id interno. Un ticket "
"está abierto mientras su etapa no esté plegada en el flujo de su equipo."

#. module: alda_ai_tool_helpdesk
#. odoo-python
#: code:addons/alda_ai_tool_helpdesk/models/alda_helpdesk_tools.py:0
msgid "The summary is empty."
msgstr "El título está vacío."

#. module: alda_ai_tool_helpdesk
#. odoo-python
#: code:addons/alda_ai_tool_helpdesk/models/alda_helpdesk_tools.py:0
#: code:addons/alda_ai_tool_helpdesk/models/alda_helpdesk_tools.py:0
msgid "The ticket no longer exists."
msgstr "El ticket ya no existe."

#. module: alda_ai_tool_helpdesk
#. odoo-python
#: code:addons/alda_ai_tool_helpdesk/models/alda_helpdesk_tools.py:0
#, python-format
msgid "Ticket %(ref)s, %(stage)s: %(title)s."
msgstr "Ticket %(ref)s, %(stage)s: %(title)s."

#. module: alda_ai_tool_helpdesk
#. odoo-python
#: code:addons/alda_ai_tool_helpdesk/models/alda_helpdesk_tools.py:0
msgid ""
"Tickets without a hotel are included (every helpdesk user sees them); the "
"rest are limited to your hotels."
msgstr ""
"Se incluyen los tickets sin hotel (los ven todos los usuarios del "
"helpdesk); el resto se limita a tus hoteles."

#. module: alda_ai_tool_helpdesk
#. odoo-python
#: code:addons/alda_ai_tool_helpdesk/models/alda_helpdesk_tools.py:0
#, python-format
msgid "Times are in the time zone %s."
msgstr "Las horas están en la zona horaria %s."

#. module: alda_ai_tool_helpdesk
#. odoo-python
#: code:addons/alda_ai_tool_helpdesk/models/alda_helpdesk_tools.py:0
msgid "To-Do"
msgstr "Por hacer"

#. module: alda_ai_tool_helpdesk
#. odoo-python
#: code:addons/alda_ai_tool_helpdesk/models/alda_helpdesk_tools.py:0
#, python-format
msgid "Unknown team %s, or you cannot see it."
msgstr "Equipo %s desconocido, o no puedes verlo."

#. module: alda_ai_tool_helpdesk
#. odoo-python
#: code:addons/alda_ai_tool_helpdesk/models/alda_helpdesk_tools.py:0
#, python-format
msgid "User %s is not an active internal user that you can see."
msgstr "El usuario %s no es un usuario interno activo que puedas ver."

#. module: alda_ai_tool_helpdesk
#. odoo-python
#: code:addons/alda_ai_tool_helpdesk/models/alda_helpdesk_tools.py:0
#, python-format
msgid ""
"last_update is the last time the ticket was saved. Times are in the time "
"zone %s."
msgstr ""
"last_update es la última vez que se guardó el ticket. Las horas están en "
"la zona horaria %s."
