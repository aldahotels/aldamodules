<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_agora_tax_override_tree" model="ir.ui.view">
        <field name="name">agora.tax.override.tree</field>
        <field name="model">agora.tax.override</field>
        <field name="arch" type="xml">
            <tree>
                <field name="company_id" />
                <field name="workplace_id" />
                <field name="workplace_name" />
                <field name="vat_rate" />
                <field name="tax_id" />
            </tree>
        </field>
    </record>

    <record id="view_agora_tax_override_form" model="ir.ui.view">
        <field name="name">agora.tax.override.form</field>
        <field name="model">agora.tax.override</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="backend_id" />
                        <field name="company_id" />
                        <field name="workplace_id" />
                        <field name="workplace_name" />
                        <field name="vat_rate" />
                        <field name="tax_id" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_agora_tax_override" model="ir.actions.act_window">
        <field name="name">Agora Tax Overrides</field>
        <field name="res_model">agora.tax.override</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
