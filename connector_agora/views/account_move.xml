<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <!-- ================================================================
         Extend account.move form view:
         - visibility of partner_shipping_id, fiscal_position_id,
           reversed_entry_id and ref
         - Add "Agora TPV" tab in the notebook
         ================================================================ -->
    <record id="view_account_move_agora_form" model="ir.ui.view">
        <field name="name">account.move.form.agora.tab</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">

            <!-- partner_shipping_id always visible (normally requires
                 the "Delivery Addresses" feature group) -->
            <xpath expr="//field[@name='partner_shipping_id']" position="attributes">
                <attribute name="groups" />
                <attribute
                    name="attrs"
                >{'readonly': [('state', '!=', 'draft')]}</attribute>
            </xpath>

            <!-- the "Accounting" group in Other Info always visible
                 (fiscal_position_id lives here; normally hidden for non-invoice types) -->
            <xpath
                expr="//page[@name='other_info']//group[@name='accounting_info_group']"
                position="attributes"
            >
                <attribute name="attrs">{}</attribute>
            </xpath>

            <!-- the "Invoice" group in Other Info always visible
                 (ref / Customer Reference lives here; normally hidden for bills) -->
            <xpath
                expr="//page[@name='other_info']//group[@name='sale_info_group']"
                position="attributes"
            >
                <attribute name="attrs">{}</attribute>
            </xpath>

            <!-- Add reversed_entry_id inside the invoice Other Info tab
                 (originally only shown in the entry-only tab) -->
            <xpath
                expr="//page[@name='other_info']//group[@name='accounting_info_group']/field[@name='fiscal_position_id']"
                position="after"
            >
                <field name="reversed_entry_id" />
            </xpath>

            <xpath expr="//page[@name='other_info']" position="after">
                <page
                    string="Agora TPV"
                    name="agora_tab"
                    attrs="{'invisible': [('agora_bind_ids', '=', [])]}"
                >
                    <field name="agora_bind_ids" readonly="1" nolabel="1">
                        <tree>
                            <field name="agora_invoice_id" string="Agora ID" />
                            <field name="agora_series" string="Series" />
                            <field name="agora_number" string="Number" />
                            <field name="agora_document_type" string="Type" />
                            <field name="agora_workplace_name" string="Workplace" />
                            <field name="agora_pos_id" string="POS" />
                            <field name="agora_business_day" string="Business Day" />
                            <field name="agora_customer_id" string="Agora Customer" />
                            <field name="import_date" string="Imported On" />
                            <field name="source_file" string="Source File" />
                            <field name="backend_id" string="Backend" />
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Dedicated list view for Agora invoices showing Agora-specific fields -->
    <record id="view_agora_account_move_list" model="ir.ui.view">
        <field name="name">account.move.agora.list</field>
        <field name="model">account.move</field>
        <field name="arch" type="xml">
            <tree decoration-muted="state == 'cancel'">
                <field name="invoice_date" string="Date" />
                <field name="name" string="Odoo Number" />
                <field name="agora_invoice_ref" string="Agora Number" />
                <field name="agora_origin" string="Workplace" />
                <field name="partner_id" string="Customer" />
                <field name="amount_untaxed" string="Untaxed Amount" />
                <field name="amount_tax" string="Tax" />
                <field name="amount_total" string="Total" />
                <field name="state" string="Status" />
            </tree>
        </field>
    </record>

    <!-- Dedicated action to list ALL invoices imported from ANY Agora backend.
         Reachable from Accounting > Customers > Agora Invoices.-->
    <record id="action_agora_invoices_accounting" model="ir.actions.act_window">
        <field name="name">Agora Invoices</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_agora_account_move_list" />
        <field name="domain">[
            ('move_type', '=', 'out_invoice'),
            ('agora_bind_ids', '!=', False)
        ]</field>
        <field name="context">{
            'default_move_type': 'out_invoice',
            'search_default_sale_journal': 1,
        }</field>
    </record>

    <!-- Menu entry inside Accounting > Customers > Agora Invoices-->
    <menuitem
        id="menu_agora_invoices_accounting"
        name="Agora Invoices"
        parent="account.menu_finance_receivables"
        action="action_agora_invoices_accounting"
        sequence="99"
    />

    <!-- Configuration menu: Accounting > Configuration > Agora POS Backends-->
    <menuitem
        id="menu_agora_backend_accounting"
        name="Agora POS Backends"
        parent="account.menu_finance_configuration"
        action="action_agora_backend"
        sequence="99"
    />

</odoo>
