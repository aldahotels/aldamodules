<odoo>
  <!-- Vista Tree  -->
  <record id="view_budget_capex_tree" model="ir.ui.view">
    <field name="name">budget.capex.tree</field>
    <field name="model">budget.capex</field>
    <field name="arch" type="xml">
      <tree>
        <field name="responsible" />
        <field name="description" />
        <field name="accounting_account" />
        <field name="company" />
        <field name="hotel" />
        <field name="year" />
        <field name="oct" />
        <field name="nov" />
        <field name="dec" />
        <field name="jan" />
        <field name="feb" />
        <field name="mar" />
        <field name="apr" />
        <field name="may" />
        <field name="jun" />
        <field name="jul" />
        <field name="aug" />
        <field name="sep" />
        <field name="total" readonly="1" />
      </tree>
    </field>
  </record>
  <!-- Vista Form-->
  <record id="view_budget_capex_form" model="ir.ui.view">
    <field name="name">budget.capex.form</field>
    <field name="model">budget.capex</field>
    <field name="arch" type="xml">
      <form string="Budget capex">
        <sheet>
          <group>
            <field name="year" />
            <field name="responsible" />
            <field name="description" />
            <field name="accounting_account" />
            <field name="company" />
            <field name="hotel" />
          </group>
          <notebook>
            <page string="Months">
              <group>
                <field name="oct" />
                <field name="nov" />
                <field name="dec" />
                <field name="jan" />
                <field name="feb" />
                <field name="mar" />
                <field name="apr" />
                <field name="may" />
                <field name="jun" />
                <field name="jul" />
                <field name="aug" />
                <field name="sep" />
              </group>
            </page>
            <page string="Totals">
              <field name="total" readonly="1" />
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>
  <!-- Vista Pivot -->
  <record id="view_budget_capex_pivot" model="ir.ui.view">
    <field name="name">budget.capex.pivot</field>
    <field name="model">budget.capex</field>
    <field name="arch" type="xml">
      <pivot string="capex Pivot">
        <field name="year" type="row" />
        <field name="hotel" type="row" />
        <field name="responsible" type="row" />
        <field name="total" type="measure" sum="True" />
      </pivot>
    </field>
  </record>

    <!-- Vista Search -->
  <record id="view_budget_capex_search" model="ir.ui.view">
    <field name="name">budget.capex.search</field>
    <field name="model">budget.capex</field>
    <field name="arch" type="xml">
      <search string="Capex Budget Search">
        <field name="responsible" />
        <field name="hotel" />
        <field name="year" />
        <field name="company" />
        <separator />
        <filter name="group_by_year" string="Year" context="{'group_by': 'year'}" />
        <filter name="group_by_hotel" string="Hotel" context="{'group_by': 'hotel'}" />
        <filter
                    name="group_by_responsible"
                    string="Responsible"
                    context="{'group_by': 'responsible'}"
                />
        <filter
                    name="group_by_company"
                    string="Company"
                    context="{'group_by': 'company'}"
                />
      </search>
    </field>
  </record>

  <!-- Menú Principal -->
  <menuitem id="menu_budget_root" name="Budget" sequence="10" />

  <!-- Submenú -->
  <menuitem
        id="menu_budget_capex"
        name="Revenue"
        parent="menu_budget_root"
        sequence="1"
    />

  <!-- Acción -->
  <record id="action_budget_capex" model="ir.actions.act_window">
    <field name="name">capex</field>
    <field name="res_model">budget.capex</field>
    <field name="view_mode">tree,form,pivot</field>
    <field
            name="context"
        >{'search_default_group_by_year': 1, 'search_default_group_by_hotel': 1}</field>
    <field name="help" type="html">
      <p class="oe_view_nocontent_smiling_face">
        Create records for each hotel.
      </p>
    </field>
  </record>

  <menuitem
        id="menu_budget_revenue_action"
        parent="menu_budget_capex"
        action="action_budget_capex"
        sequence="1"
    />

</odoo>
