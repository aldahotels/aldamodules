<odoo>
  <!-- Vista Tree -->
  <record id="view_budget_informatica_tree" model="ir.ui.view">
    <field name="name">budget.informatica.tree</field>
    <field name="model">budget.informatica</field>
    <field name="arch" type="xml">
      <tree>
        <field name="record_type" />
        <field name="responsible" />
        <field name="description" />
        <field name="accounting_account" placeholder="e.g. 627001" />
        <field name="hotel" />
        <field name="hotel_id" />
        <!--<field name="hotel_code" readonly="1" />-->
        <field name="company" />
        <field name="year" />
        <field
                    name="rooms_available_current"
                    readonly="1"
                    attrs="{'invisible': [('record_type', '=', 'manual')]}"
                />
        <field
                    name="manual_amount"
                    attrs="{'invisible': [('record_type', '=', 'manual')]}"
                />
        <field name="oct" />
        <field name="nov" />
        <field name="dec" />
        <field name="jan" />
        <field name="feb" />
        <field name="mar" />
        <field name="apr" />
        <field name="may" />
        <field name="jun" />
        <field name="jul" />
        <field name="aug" />
        <field name="sep" />
        <field name="total" readonly="1" />
      </tree>
    </field>
  </record>
  <!-- Vista Form -->
  <record id="view_budget_informatica_form" model="ir.ui.view">
    <field name="name">budget.informatica.form</field>
    <field name="model">budget.informatica</field>
    <field name="arch" type="xml">
      <form string="Budget IT">
        <sheet>
          <group>
            <group string="Basic Information">
              <field name="record_type" />
              <field
                                name="rooms_available_current"
                                readonly="1"
                                attrs="{'invisible': [('record_type', '=', 'manual')]}"
                            />
              <field
                                name="manual_amount"
                                attrs="{'invisible': [('record_type', '=', 'manual')]}"
                            />
              <field name="responsible" />
              <field name="description" />
              <field name="accounting_account" />
            </group>
            <group name="hotel_info" string="Hotel &amp; Company">
              <field name="hotel" />
              <field name="hotel_id" />
              <field name="hotel_code" readonly="1" />
              <field name="company" />
              <field name="year" />
            </group>
          </group>
          <notebook>
            <page string="Months">
              <group string="Budget Planning" col="4">
                <field name="oct" />
                <field name="nov" />
                <field name="dec" />
                <field name="jan" />
                <field name="feb" />
                <field name="mar" />
                <field name="apr" />
                <field name="may" />
                <field name="jun" />
                <field name="jul" />
                <field name="aug" />
                <field name="sep" />
              </group>
            </page>
            <page string="Totals">
              <field name="total" readonly="1" />
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>
  <!-- Vista Pivot -->
  <record id="view_budget_informatica_pivot" model="ir.ui.view">
    <field name="name">budget.informatica.pivot</field>
    <field name="model">budget.informatica</field>
    <field name="arch" type="xml">
      <pivot string="informatica Pivot">
        <field name="year" type="row" />
        <field name="hotel" type="row" />
        <field name="responsible" type="row" />
        <field name="total" type="measure" sum="True" />
      </pivot>
    </field>
  </record>

  <!-- Vista Search -->
  <record id="view_budget_informatica_search" model="ir.ui.view">
    <field name="name">budget.informatica.search</field>
    <field name="model">budget.informatica</field>
    <field name="arch" type="xml">
      <search string="Informatica Budget Search">
        <field name="responsible" />
        <field name="hotel" />
        <field name="year" />
        <field name="company" />
        <field name="record_type" />
        <separator />
        <filter name="group_by_year" string="Year" context="{'group_by': 'year'}" />
        <filter name="group_by_hotel" string="Hotel" context="{'group_by': 'hotel'}" />
        <filter
                    name="group_by_record_type"
                    string="Record Type"
                    context="{'group_by': 'record_type'}"
                />
        <filter
                    name="group_by_responsible"
                    string="Responsible"
                    context="{'group_by': 'responsible'}"
                />
        <filter
                    name="group_by_company"
                    string="Company"
                    context="{'group_by': 'company'}"
                />
      </search>
    </field>
  </record>

  <!-- Action -->
  <record id="action_budget_informatica" model="ir.actions.act_window">
    <field name="name">informatica</field>
    <field name="res_model">budget.informatica</field>
    <field name="view_mode">tree,form,pivot</field>
    <field
            name="context"
        >{'search_default_group_by_year': 1, 'search_default_group_by_hotel': 1}</field>
    <field name="help" type="html">
      <p class="oe_view_nocontent_smiling_face">
        Create records for each hotel.
      </p>
    </field>
  </record>

  <menuitem
        id="menu_budget_informatica_action"
        name="Informatica"
        parent="menu_budget_root"
        action="action_budget_informatica"
        sequence="5"
    />

</odoo>
