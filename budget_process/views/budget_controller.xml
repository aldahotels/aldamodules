<odoo>
    <!-- Vista Tree -->
    <record id="view_budget_controller_tree" model="ir.ui.view">
        <field name="name">budget.controller.tree</field>
        <field name="model">budget.controller</field>
        <field name="arch" type="xml">
            <tree>
                <field name="responsible" />
                <field name="description" />
                <field name="accounting_account" placeholder="e.g. 627001" />
                <field name="company" />
                <field name="hotel" options="{'no_create': True}" />
                <field name="hotel_code" readonly="1" />
                <field name="year" />
                <field name="oct" />
                <field name="nov" />
                <field name="dec" />
                <field name="jan" />
                <field name="feb" />
                <field name="mar" />
                <field name="apr" />
                <field name="may" />
                <field name="jun" />
                <field name="jul" />
                <field name="aug" />
                <field name="sep" />
                <field name="total" readonly="1" />
            </tree>
        </field>
    </record>

    <!-- Vista Form -->
    <record id="view_budget_controller_form" model="ir.ui.view">
        <field name="name">budget.controller.form</field>
        <field name="model">budget.controller</field>
        <field name="arch" type="xml">
            <form string="Controller Budget">
                <sheet>
                    <group>
                        <group name="basic_info" string="Basic Information">
                            <field name="responsible" />
                            <field name="description" />
                            <field
                                name="accounting_account"
                                placeholder="e.g. 627001"
                            />
                        </group>
                        <group name="hotel_info" string="Hotel &amp; Company">
                            <field name="hotel" options="{'no_create': True}" />
                            <field name="hotel_code" readonly="1" />
                            <field name="company" />
                            <field name="year" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Months">
                            <group string="Monthly Values" col="4">
                                <field name="oct" string="October" />
                                <field name="nov" string="November" />
                                <field name="dec" string="December" />
                                <field name="jan" string="January" />
                                <field name="feb" string="February" />
                                <field name="mar" string="March" />
                                <field name="apr" string="April" />
                                <field name="may" string="May" />
                                <field name="jun" string="June" />
                                <field name="jul" string="July" />
                                <field name="aug" string="August" />
                                <field name="sep" string="September" />
                            </group>
                            <group string="Total">
                                <field name="total" readonly="1" />
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vista Pivot -->
    <record id="view_budget_controller_pivot" model="ir.ui.view">
        <field name="name">budget.controller.pivot</field>
        <field name="model">budget.controller</field>
        <field name="arch" type="xml">
            <pivot string="Controller Budget Pivot">
                <field name="year" type="row" />
                <field name="hotel" type="row" />
                <field name="total" type="measure" sum="True" />
                <field name="oct" type="measure" sum="True" />
                <field name="nov" type="measure" sum="True" />
                <field name="dec" type="measure" sum="True" />
                <field name="jan" type="measure" sum="True" />
                <field name="feb" type="measure" sum="True" />
                <field name="mar" type="measure" sum="True" />
                <field name="apr" type="measure" sum="True" />
                <field name="may" type="measure" sum="True" />
                <field name="jun" type="measure" sum="True" />
                <field name="jul" type="measure" sum="True" />
                <field name="aug" type="measure" sum="True" />
                <field name="sep" type="measure" sum="True" />
            </pivot>
        </field>
    </record>

    <!-- Vista Search -->
    <record id="view_budget_controller_search" model="ir.ui.view">
        <field name="name">budget.controller.search</field>
        <field name="model">budget.controller</field>
        <field name="arch" type="xml">
            <search string="Controller Budget Search">
                <field name="responsible" />
                <field name="hotel" />
                <field name="year" />
                <field name="accounting_account" />
                <separator />
                <filter
                    name="group_by_year"
                    string="Year"
                    context="{'group_by': 'year'}"
                />
                <filter
                    name="group_by_hotel"
                    string="Hotel"
                    context="{'group_by': 'hotel'}"
                />
                <filter
                    name="group_by_responsible"
                    string="Responsible"
                    context="{'group_by': 'responsible'}"
                />
            </search>
        </field>
    </record>

    <!-- Acción para Controller -->
    <record id="action_budget_controller" model="ir.actions.act_window">
        <field name="name">Controller Budget</field>
        <field name="res_model">budget.controller</field>
        <field name="view_mode">tree,form,pivot</field>
        <field
            name="context"
        >{'search_default_group_by_year': 1, 'search_default_group_by_hotel': 1}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_smiling_face">
                Create Controller budget records for each hotel.
            </p>

        </field>
    </record>

    <!-- Menú para Controller -->
    <menuitem
        id="menu_budget_controller"
        name="Controller"
        parent="menu_budget_root"
        sequence="9"
        action="action_budget_controller"
    />
</odoo>
