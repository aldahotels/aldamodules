<odoo>
  <!-- Vista Tree -->
  <record id="view_budget_cfo_tree" model="ir.ui.view">
    <field name="name">budget.cfo.tree</field>
    <field name="model">budget.cfo</field>
    <field name="arch" type="xml">
      <tree>
        <field name="responsible" />
        <field name="description" />
        <field name="accounting_account" />
        <field name="company" />
        <field name="hotel" />
        <field name="hotel_id" />
        <field name="year" />
        <field name="oct" />
        <field name="nov" />
        <field name="dec" />
        <field name="jan" />
        <field name="feb" />
        <field name="mar" />
        <field name="apr" />
        <field name="may" />
        <field name="jun" />
        <field name="jul" />
        <field name="aug" />
        <field name="sep" />
        <field name="total" readonly="1" />
      </tree>
    </field>
  </record>
  <!-- Vista Form -->
  <record id="view_budget_cfo_form" model="ir.ui.view">
    <field name="name">budget.cfo.form</field>
    <field name="model">budget.cfo</field>
    <field name="arch" type="xml">
      <form string="Budget cfo">
        <sheet>
          <group>
            <field name="responsible" />
            <field name="description" />
            <field name="accounting_account" />
            <field name="company" />
            <field name="hotel" />
            <field name="hotel_id" />
            <field name="hotel_code" readonly="1" />
            <field name="year" />
          </group>
          <notebook>
            <page string="Months">
              <group>
                <field name="oct" />
                <field name="nov" />
                <field name="dec" />
                <field name="jan" />
                <field name="feb" />
                <field name="mar" />
                <field name="apr" />
                <field name="may" />
                <field name="jun" />
                <field name="jul" />
                <field name="aug" />
                <field name="sep" />
              </group>
            </page>
            <page string="Totals">
              <field name="total" readonly="1" />
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>
  <!-- Vista Pivot -->
  <record id="view_budget_cfo_pivot" model="ir.ui.view">
    <field name="name">budget.cfo.pivot</field>
    <field name="model">budget.cfo</field>
    <field name="arch" type="xml">
      <pivot string="cfo Pivot">
        <field name="year" type="row" />
        <field name="hotel" type="row" />
        <field name="responsible" type="row" />
        <field name="total" type="measure" sum="True" />
      </pivot>
    </field>
  </record>

  <record id="view_budget_cfo_search" model="ir.ui.view">
    <field name="name">budget.cfo.search</field>
    <field name="model">budget.cfo</field>
    <field name="arch" type="xml">
      <search string="CFO Budget Search">
        <field name="responsible" />
        <field name="hotel" />
        <field name="year" />
        <field name="company" />
        <separator />
        <filter name="group_by_year" string="Year" context="{'group_by': 'year'}" />
        <filter name="group_by_hotel" string="Hotel" context="{'group_by': 'hotel'}" />
        <filter
                    name="group_by_responsible"
                    string="Responsible"
                    context="{'group_by': 'responsible'}"
                />
        <filter
                    name="group_by_company"
                    string="Company"
                    context="{'group_by': 'company'}"
                />
      </search>
    </field>
  </record>

  <!-- Action -->
  <record id="action_budget_cfo" model="ir.actions.act_window">
    <field name="name">cfo</field>
    <field name="res_model">budget.cfo</field>
    <field name="view_mode">tree,form,pivot</field>
    <field
            name="context"
        >{'search_default_group_by_year': 1, 'search_default_group_by_hotel': 1}</field>
    <field name="help" type="html">
      <p class="oe_view_nocontent_smiling_face">
        Create records for each hotel.
      </p>
    </field>
  </record>

  <menuitem
        id="menu_budget_cfo_action"
        name="CFO"
        parent="menu_budget_root"
        action="action_budget_cfo"
        sequence="7"
    />

</odoo>
