<odoo>
    <!-- Vista Tree -->
  <record id="view_budget_revenue_tree" model="ir.ui.view">
    <field name="name">budget.revenue.tree</field>
    <field name="model">budget.revenue</field>
    <field name="arch" type="xml">
      <tree>
        <field name="record_type" />
        <field name="responsible" />
        <field name="description" />
        <field
                    name="accounting_account"
                    attrs="{'invisible': [('record_type', '!=', 'account_budget')]}"
                />
        <field name="company" />
        <field name="hotel" />
        <field name="hotel_id" />
        <field name="year" />
        <field name="oct" />
        <field name="nov" />
        <field name="dec" />
        <field name="jan" />
        <field name="feb" />
        <field name="mar" />
        <field name="apr" />
        <field name="may" />
        <field name="jun" />
        <field name="jul" />
        <field name="aug" />
        <field name="sep" />
        <field name="total" readonly="1" />
      </tree>
    </field>
  </record>
  <!-- Vista Form  -->
  <record id="view_budget_revenue_form" model="ir.ui.view">
    <field name="name">budget.revenue.form</field>
    <field name="model">budget.revenue</field>
    <field name="arch" type="xml">
      <form string="Budget Revenue">
        <header>
          <button
                        name="refresh_monthly_pms_data"
                        type="object"
                        string="Refresh Monthly PMS Data"
                        class="btn-primary"
                        attrs="{'invisible': [('record_type', '=', 'account_budget')]}"
                        help="Update monthly data from PMS for this KPI"
                    />
          <button
                        name="generate_kpi_records"
                        type="object"
                        string="Generate All KPI Records"
                        class="btn-secondary"
                        help="Generate records for all KPIs (Room Nights, Occupancy, ADR, Revenue, PAX)"
                    />
          <button
                        name="calculate_revenue_percentages"
                        type="object"
                        string="Calculate Revenue %"
                        class="btn-info"
                        attrs="{'invisible': [('record_type', '!=', 'revenue_percentage')]}"
                        help="Calculate revenue percentages (run after all KPIs are generated)"
                    />
        </header>
        <sheet>
          <group>
            <group name="basic_info" string="Basic Information">
              <field name="record_type" />
              <field name="responsible" />
              <field name="description" />
              <field
                                name="accounting_account"
                                attrs="{'invisible': [('record_type', '!=', 'account_budget')]}"
                            />
            </group>
            <group name="hotel_info" string="Hotel &amp; Company">
              <field name="hotel" />
              <field name="hotel_id" />
              <field name="hotel_code" readonly="1" />
              <field name="company" />
              <field name="year" />
            </group>
          </group>
          <notebook>
            <page
                            string="Growth Factors"
                            attrs="{'invisible': [('record_type', '=', 'account_budget')]}"
                        >
              <group string="Growth Parameters">
                <field name="rn_growth_factor" />
                <field name="adr_growth_factor" />
                <field name="services_growth_factor" />
              </group>
            </page>
            <page string="Monthly Budget">
              <group>
                <field name="oct" />
                <field name="nov" />
                <field name="dec" />
                <field name="jan" />
                <field name="feb" />
                <field name="mar" />
                <field name="apr" />
                <field name="may" />
                <field name="jun" />
                <field name="jul" />
                <field name="aug" />
                <field name="sep" />
              </group>
            </page>
            <page string="Totals">
              <field name="total" readonly="1" />
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>
  <!-- Vista Pivot -->
  <record id="view_budget_revenue_pivot" model="ir.ui.view">
    <field name="name">budget.revenue.pivot</field>
    <field name="model">budget.revenue</field>
    <field name="arch" type="xml">
      <pivot string="Revenue Pivot">
        <field name="year" type="row" />
        <field name="hotel" type="row" />
        <field name="record_type" type="row" />
        <field name="responsible" type="row" />
        <field name="total" type="measure" sum="True" />
      </pivot>
    </field>
  </record>

  <!-- Vista Search -->
  <record id="view_budget_revenue_search" model="ir.ui.view">
    <field name="name">budget.revenue.search</field>
    <field name="model">budget.revenue</field>
    <field name="arch" type="xml">
      <search string="Revenue Budget Search">
        <field name="responsible" />
        <field name="hotel" />
        <field name="year" />
        <field name="company" />
        <field name="record_type" />
        <field name="accounting_account" />
        <separator />
        <filter
                    name="filter_room_nights"
                    string="Room Nights"
                    domain="[('record_type', '=', 'room_nights')]"
                />
        <filter
                    name="filter_occupancy"
                    string="Occupancy"
                    domain="[('record_type', '=', 'occupancy')]"
                />
        <filter name="filter_adr" string="ADR" domain="[('record_type', '=', 'adr')]" />
        <filter
                    name="filter_room_revenue"
                    string="Room Revenue"
                    domain="[('record_type', '=', 'room_revenue')]"
                />
        <filter name="filter_pax" string="PAX" domain="[('record_type', '=', 'pax')]" />
        <filter
                    name="filter_rooms_available_ly"
                    string="Rooms Available LY"
                    domain="[('record_type', '=', 'rooms_available_ly')]"
                />
        <filter
                    name="filter_rooms_available"
                    string="Rooms Available"
                    domain="[('record_type', '=', 'rooms_available')]"
                />
        <filter
                    name="filter_rn_growth"
                    string="RN Growth %"
                    domain="[('record_type', '=', 'rn_growth_percentage')]"
                />
        <filter
                    name="filter_adr_growth"
                    string="ADR Growth %"
                    domain="[('record_type', '=', 'adr_growth_percentage')]"
                />
        <filter
                    name="filter_commission"
                    string="Commission"
                    domain="[('record_type', '=', 'commission')]"
                />
        <filter
                    name="filter_revenue_percentage"
                    string="Revenue %"
                    domain="[('record_type', '=', 'revenue_percentage')]"
                />
        <filter
                    name="filter_account_budget"
                    string="Account Budget"
                    domain="[('record_type', '=', 'account_budget')]"
                />
        <separator />
        <filter
                    name="group_by_record_type"
                    string="Record Type"
                    context="{'group_by': 'record_type'}"
                />
        <filter name="group_by_year" string="Year" context="{'group_by': 'year'}" />
        <filter name="group_by_hotel" string="Hotel" context="{'group_by': 'hotel'}" />
        <filter
                    name="group_by_responsible"
                    string="Responsible"
                    context="{'group_by': 'responsible'}"
                />
        <filter
                    name="group_by_company"
                    string="Company"
                    context="{'group_by': 'company'}"
                />
      </search>
    </field>
  </record>

  <!-- Action -->
  <record id="action_budget_revenue" model="ir.actions.act_window">
    <field name="name">Revenue</field>
    <field name="res_model">budget.revenue</field>
    <field name="view_mode">tree,form,pivot</field>
    <field
            name="context"
        >{'search_default_group_by_year': 1, 'search_default_group_by_hotel': 1}</field>
    <field name="help" type="html">
      <p class="oe_view_nocontent_smiling_face">
        Create records for each hotel.
      </p>
    </field>
  </record>

  <menuitem
        id="menu_budget_revenue"
        name="Revenue"
        parent="menu_budget_root"
        action="action_budget_revenue"
        sequence="2"
    />
  </odoo>
