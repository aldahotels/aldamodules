<odoo>
  <!-- Vista Tree -->
  <record id="view_budget_revenue_tree" model="ir.ui.view">
    <field name="name">budget.revenue.tree</field>
    <field name="model">budget.revenue</field>
    <field name="arch" type="xml">
      <tree>
        <field name="budget_type" />
        <field name="record_type" />
        <field name="responsible" />
        <field name="description" />
        <field name="hotel" />
        <field name="hotel_code" readonly="1" />
        <field name="company_id" />
        <field name="fiscal_year_id" string="Fiscal Year" />
        <field name="oct" />
        <field name="nov" />
        <field name="dec" />
        <field name="jan" />
        <field name="feb" />
        <field name="mar" />
        <field name="apr" />
        <field name="may" />
        <field name="jun" />
        <field name="jul" />
        <field name="aug" />
        <field name="sep" />
        <field name="budgeted_total" readonly="1" />
        <field name="real_total" readonly="1" />
        <field name="variance_total" readonly="1" />
        <field name="variance_percentage" readonly="1" />
      </tree>
    </field>
  </record>
  <!-- Vista Form -->
  <record id="view_budget_revenue_form" model="ir.ui.view">
    <field name="name">budget.revenue.form</field>
    <field name="model">budget.revenue</field>
    <field name="arch" type="xml">
      <form string="Budget Revenue">
        <header>
          <!-- Sync Buttons for Rooms Available -->
          <button
                        name="action_refresh_rooms_available"
                        type="object"
                        string="🔄 Refresh Rooms Available"
                        class="btn-primary"
                        attrs="{'invisible': ['|', ('record_type', '!=', 'rooms_available'), ('budget_type', '!=', 'budgeted')]}"
                        help="Refresh room availability data from Budget Data"
                    />
          <button
                        name="action_show_sync_status"
                        type="object"
                        string="📊 Show Sync Status"
                        class="btn-info"
                        attrs="{'invisible': ['|', ('record_type', '!=', 'rooms_available'), ('budget_type', '!=', 'budgeted')]}"
                        help="Show current synchronization status"
                    />
          <button
                        name="action_diagnose_current_records"
                        type="object"
                        string="🔍 Diagnose Records"
                        class="btn-warning"
                        attrs="{'invisible': ['|', ('record_type', '!=', 'rooms_available'), ('budget_type', '!=', 'budgeted')]}"
                        help="Advanced diagnosis of current records"
                    />

          <!-- RN Budgeted Debug Buttons -->
          <button
                        name="action_check_rn_budgeted_dependencies"
                        type="object"
                        string="✅ Check RN Dependencies required for the formula"
                        class="btn-success"
                        attrs="{'invisible': ['|', ('record_type', '!=', 'rn_budgeted'), ('budget_type', '!=', 'budgeted')]}"
                        help="Check if all required records exist for RN Budgeted calculation"
                    />
          <button
                        name="action_debug_rn_budgeted"
                        type="object"
                        string="🔍 Debug RN Budgeted"
                        class="btn-warning"
                        attrs="{'invisible': ['|', ('record_type', '!=', 'rn_budgeted'), ('budget_type', '!=', 'budgeted')]}"
                        help="Debug RN Budgeted formula and calculation"
                    />
          <button
                        name="action_force_recalculate_rn_budgeted"
                        type="object"
                        string="🔄 Recalculate"
                        class="btn-secondary"
                        attrs="{'invisible': ['|', ('record_type', '!=', 'rn_budgeted'), ('budget_type', '!=', 'budgeted')]}"
                        help="Force recalculation of RN Budgeted values"
                    />
        </header>
        <sheet>
          <group>
            <group name="basic_info" string="Basic Information">
              <field name="responsible" />
              <field name="description" />
              <field name="record_type" />
              <field name="budget_type" />
              <field
                                name="percentage_increase_decrease"
                                attrs="{'invisible': [('record_type', '!=', 'increase_decrease_rn_ly')],
                    'required': [('record_type', '=', 'increase_decrease_rn_ly')]}"
                                widget="percentage"
                            />
            </group>
            <group name="location_info" string="Location &amp; Fiscal Year">
              <field name="hotel" />
              <field name="hotel_code" readonly="1" />
              <field name="company_id" />
              <field name="fiscal_year_id" string="Fiscal Year" />
            </group>
          </group>
          <notebook>
            <page string="Budget vs Real">
              <group string="Budget Planning" col="4">
                <field name="oct" />
                <field name="nov" />
                <field name="dec" />
                <field name="jan" />
                <field name="feb" />
                <field name="mar" />
                <field name="apr" />
                <field name="may" />
                <field name="jun" />
                <field name="jul" />
                <field name="aug" />
                <field name="sep" />
              </group>
            </page>
            <page string="Totals comparative">
                <group string="Totals" col="2">
                <field name="budgeted_total" readonly="1" />
                <field name="real_total" readonly="1" />
                <field name="variance_total" readonly="1" />
                <field name="variance_percentage" readonly="1" />
              </group>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>
  <!-- Vista Pivot -->
  <record id="view_budget_revenue_pivot" model="ir.ui.view">
    <field name="name">budget.revenue.pivot</field>
    <field name="model">budget.revenue</field>
    <field name="arch" type="xml">
      <pivot string="revenue Pivot">
        <field name="hotel" type="row" />
        <field name="responsible" type="row" />
        <field name="oct" type="measure" sum="True" />
        <field name="nov" type="measure" sum="True" />
        <field name="dec" type="measure" sum="True" />
        <field name="jan" type="measure" sum="True" />
        <field name="feb" type="measure" sum="True" />
        <field name="mar" type="measure" sum="True" />
        <field name="apr" type="measure" sum="True" />
        <field name="may" type="measure" sum="True" />
        <field name="jun" type="measure" sum="True" />
        <field name="jul" type="measure" sum="True" />
        <field name="aug" type="measure" sum="True" />
        <field name="sep" type="measure" sum="True" />
        <field name="real_total" type="measure" sum="True" />
        <field name="budgeted_total" type="measure" sum="True" />
        <field name="variance_total" type="measure" sum="True" />
        <field name="variance_percentage" type="measure" sum="True" />
      </pivot>
    </field>
  </record>
  <!-- Vista Search -->
  <record id="view_budget_revenue_search" model="ir.ui.view">
    <field name="name">budget.revenue.search</field>
    <field name="model">budget.revenue</field>
    <field name="arch" type="xml">
      <search string="Revenue Budget Search">
        <field name="responsible" />
        <field name="hotel" />
        <field name="fiscal_year_id" string="Fiscal Year" />
        <field name="company_id" />
        <separator />
        <filter
                    name="group_by_year"
                    string="Year"
                    context="{'group_by': 'fiscal_year_id'}"
                />
        <filter name="group_by_hotel" string="Hotel" context="{'group_by': 'hotel'}" />
        <filter
                    name="group_by_budget_type"
                    string="Budget Type"
                    context="{'group_by': 'budget_type'}"
                />
        <filter
                    name="group_by_responsible"
                    string="Responsible"
                    context="{'group_by': 'responsible'}"
                />
        <filter
                    name="group_by_company"
                    string="Company"
                    context="{'group_by': 'company_id'}"
                />
      </search>
    </field>
  </record>

  <!-- Action -->
  <record id="action_budget_revenue" model="ir.actions.act_window">
    <field name="name">revenue</field>
    <field name="res_model">budget.revenue</field>
    <field name="view_mode">tree,form,pivot</field>
    <field
            name="context"
        >{'search_default_group_by_year': 1, 'search_default_group_by_hotel': 1, 'search_default_group_by_budget_type': 1}</field>
    <field name="help" type="html">
      <p class="oe_view_nocontent_smiling_face">
        Create records for each hotel.
      </p>
    </field>
  </record>

  <!-- Server Action -->
  <record id="action_server_sync_all_rooms" model="ir.actions.server">
    <field name="name">🔄 Sync All Rooms Disponibles</field>
    <field name="model_id" ref="model_budget_revenue" />
    <field name="binding_model_id" ref="model_budget_revenue" />
    <field name="binding_view_types">list</field>
    <field name="state">code</field>
    <field name="code">
      action = records.action_sync_all_rooms_disponibles()
    </field>
  </record>

  <record id="action_server_sync_all_room_nights" model="ir.actions.server">
    <field name="name">🌙 Sync All Room Nights</field>
    <field name="model_id" ref="model_budget_revenue" />
    <field name="binding_model_id" ref="model_budget_revenue" />
    <field name="binding_view_types">list</field>
    <field name="state">code</field>
    <field name="code">
      action = records.action_sync_all_room_nights()
    </field>
  </record>

    <menuitem
        id="menu_budget_revenue"
        name="Revenue"
        parent="menu_budget_root"
        action="action_budget_revenue"
        sequence="2"
        groups="base.group_user"
    />
</odoo>
